{
	"schemaVersion": 1,
	"id": "better-creeper-consent",
	"version": "${version}",
	"name": "Better Creeper Consent",
	"description": "You decide whether creepers explode or not!",
	"authors": [
		"wuritz"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/better-creeper-consent/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "wuritz.bcc.BetterCreeperConsent",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "wuritz.bcc.client.BetterCreeperConsentClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"better-creeper-consent.mixins.json",
		{
			"config": "better-creeper-consent.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}