{
	"schemaVersion": 1,
	"id": "better-creeper-consent",
	"version": "${version}",
	"name": "Better Creeper Consent",
	"description": "Make creepers ask for permission before blowing up everything around you!",
	"authors": [
		"wuritz"
	],
	"contact": {
		"homepage": "https://github.com/wuritz/better-creeper-consent",
		"sources": "https://github.com/wuritz/better-creeper-consent",
		"issues": "https://github.com/wuritz/better-creeper-consent/issues"
	},
	"license": "MIT",
	"icon": "assets/better-creeper-consent/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "wuritz.bcc.BetterCreeperConsent",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "wuritz.bcc.client.BetterCreeperConsentClient",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "wuritz.bcc.client.ModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"better-creeper-consent.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"yet_another_config_lib_v3": ">=3.9.4",
		"modmenu": ">=20.0.0"
	}
}